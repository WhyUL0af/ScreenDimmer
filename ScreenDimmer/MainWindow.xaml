<Window x:Class="ScreenDimmer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenDimmer"
        Width="380"
        Height="290"
        MinWidth="340"
        MinHeight="270"
        WindowStartupLocation="CenterScreen"
        Background="#171923">

	<Window.Resources>
		<Style TargetType="TextBlock">
			<Setter Property="Foreground"
                    Value="#F3F4F6"/>
			<Setter Property="FontFamily"
                    Value="Segoe UI"/>
		</Style>
	</Window.Resources>

	<Border Margin="20"
            Padding="20"
            CornerRadius="14"
            Background="#242734">

		<StackPanel>

			<TextBlock Text="ScreenDimmer"
                       FontSize="24"
                       FontWeight="Bold"/>

			<TextBlock Text="Adjust your screen darkness"
                       FontSize="12"
                       Foreground="#A0A5B5"
                       Margin="0,6,0,25"/>

			<DockPanel Margin="0,0,0,12">

				<TextBlock Text="Darkness"
                           FontSize="15"
                           FontWeight="SemiBold"/>

				<TextBlock x:Name="DarknessText"
                           Text="0%"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Cyan"
                           HorizontalAlignment="Right"/>

			</DockPanel>

			<Slider x:Name="DarknessSlider"
                    Minimum="0"
                    Maximum="90"
                    Value="0"
                    TickFrequency="5"
                    IsSnapToTickEnabled="False"
                    ValueChanged="DarknessSlider_ValueChanged"
                    Margin="0,0,0,12"/>

			<DockPanel Margin="0,0,0,22">
				<TextBlock Text="Normal"
                           FontSize="11"
                           Foreground="#A0A5B5"/>

				<TextBlock Text="Darker"
                           FontSize="11"
                           Foreground="#A0A5B5"
                           HorizontalAlignment="Right"/>
			</DockPanel>

			<Button Content="Reset to Normal"
                    Height="36"
                    Background="Cyan"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ResetButton_Click"/>

		</StackPanel>

	</Border>
</Window>
